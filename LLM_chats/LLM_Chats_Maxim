class SimpleUNet(nn.Module):
    def __init__(self, num_classes, time_emb_dim=32):
        super().__init__()
        self.time_embed = nn.Sequential(
            nn.Linear(1, time_emb_dim), nn.ReLU(), nn.Linear(time_emb_dim, time_emb_dim)
