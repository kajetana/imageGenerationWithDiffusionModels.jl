class ConditionalUNet(nn.Module):
    def __init__(self, cond_dim=128, time_dim=128):
        super().__init__()
        self.time_embed = nn.Sequential(
            nn.Linear(1, time_dim),
            nn.ReLU(),
            nn.Linear(time_dim, time_dim)
        )
