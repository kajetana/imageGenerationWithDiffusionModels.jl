🔧 Full U-Net with Skip Connections + Conditioning

import torch
import torch.nn as nn
import torch.nn.functional as F

class SinusoidalTimeEmbedding(nn.Module):
    def __init__(self, dim):
        super().__init__()
        self.dim = dim

    def forward(self, t):
        half_dim = self.dim // 2
        emb = torch.exp(
            torch.arange(half_dim, dtype=torch.float32, device=t.device) * 
            -(torch.log(torch.tensor(10000.0)) / (half_dim - 1))
        )
        emb = t[:, None] * emb[None, :]
        return torch.cat([torch.sin(emb), torch.cos(emb)], dim=1)  # [B, dim]

class FeatureEncoder(nn.Module):
    def __init__(self, num_classes=6, out_dim=128):
        super().__init__()
        self.model = nn.Sequential(
            nn.Embedding(num_classes, 32),
            nn.Linear(32, 64),
            nn.ReLU(),
            nn.Linear(64, out_dim)
        )

    def forward(self, y):
        return self.model(y)

class ResidualBlock(nn.Module):
    def __init__(self, in_channels, out_channels, emb_dim):
        super().__init__()
        self.conv1 = nn.Conv2d(in_channels, out_channels, 3, padding=1)
        self.norm1 = nn.GroupNorm(8, out_channels)
        self.emb_proj = nn.Linear(emb_dim, out_channels)
        self.conv2 = nn.Conv2d(out_channels, out_channels, 3, padding=1)
        self.norm2 = nn.GroupNorm(8, out_channels)

    def forward(self, x, emb):
        h = self.norm1(self.conv1(x))
        h = h + self.emb_proj(emb)[:, :, None, None]
        h = F.relu(h)
        h = self.norm2(self.conv2(h))
        return F.relu(h + x)

class ConditionalUNet(nn.Module):
    def __init__(self, num_classes=6, emb_dim=128):
        super().__init__()
        self.time_mlp = SinusoidalTimeEmbedding(emb_dim)
        self.label_encoder = FeatureEncoder(num_classes, emb_dim)

        # Down path
        self.down1 = ResidualBlock(1, 64, emb_dim)
        self.down2 = ResidualBlock(64, 128, emb_dim)
        self.pool = nn.MaxPool2d(2)

        # Middle
        self.middle = ResidualBlock(128, 128, emb_dim)

        # Up path
        self.up1 = ResidualBlock(128 + 128, 64, emb_dim)
        self.up2 = ResidualBlock(64 + 64, 64, emb_dim)

        self.out_conv = nn.Conv2d(64, 1, 1)

    def forward(self, x_t, t, y):
        # Embed time and label
        time_emb = self.time_mlp(t)  # [B, emb_dim]
        label_emb = self.label_encoder(y)  # [B, emb_dim]
        cond_emb = time_emb + label_emb

        # Down
        d1 = self.down1(x_t, cond_emb)  # [B, 64, H, W]
        d2 = self.down2(self.pool(d1), cond_emb)  # [B, 128, H/2, W/2]

        # Middle
        m = self.middle(self.pool(d2), cond_emb)  # [B, 128, H/4, W/4]

        # Up
        u1 = F.interpolate(m, scale_factor=2)  # [B, 128, H/2, W/2]
        u1 = self.up1(torch.cat([u1, d2], dim=1), cond_emb)

        u2 = F.interpolate(u1, scale_factor=2)  # [B, 64, H, W]
        u2 = self.up2(torch.cat([u2, d1], dim=1), cond_emb)

        return self.out_conv(u2)

🧪 How to Use This
Instantiate and use during training:

