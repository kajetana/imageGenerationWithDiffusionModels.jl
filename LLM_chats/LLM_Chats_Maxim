        self.middle = nn.Sequential(nn.Conv2d(64, 64, 3, padding=1), nn.ReLU())
        self.up = nn.Sequential(
            nn.Conv2d(64, 32, 3, padding=1), nn.ReLU(),
            nn.Conv2d(32, 1, 3, padding=1)
        )

